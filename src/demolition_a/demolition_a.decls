000e7b30 void CModuleDemolition_Shutdown(void *self);
000e7b50 int CModuleDemolition_Start(void *self, int variation);
000e7b60 void *CModuleDemolition_DeletingDtor(void *self, unsigned int flags);
000e7b80 int CModuleDemolition_Init(void *self);

